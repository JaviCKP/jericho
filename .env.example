# ===================================================================
# OPENPC-MCP SUITE CONFIGURATION TEMPLATE
# ===================================================================

# 1. Identificador de túnel obtenido en https://platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef

# 2. Clave API obtenida en https://platform.openai.com/settings/organization/api-keys (Permisos Tunnels: Read + Use)
CONTROL_PLANE_API_KEY=sk-proj-tu_clave_api_aqui

# 3. Carpeta de trabajo exclusiva para proyectos y archivos de ChatGPT
CHATGPT_WORKSPACE=C:\Users\javi\ChatGPT-Workspace

# 4. Nivel de logs: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# 5. Tiempo límite por defecto para comandos de terminal (en milisegundos)
DEFAULT_TIMEOUT_MS=60000

# 6. Activar cuadrícula de coordenadas superpuesta en capturas de pantalla por defecto
ENABLE_GRID_OVERLAY=false
